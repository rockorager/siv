# A theme drawn like Adwaita: symbolic icons in scalable directories,
# a fixed-size PNG with a scaled variant. Test data written for siv.
[Icon Theme]
Name=SivTest
Comment=siv's test theme
Inherits=hicolor
Directories=16x16/actions,24x24/actions,scalable/actions,scalable/status,scalable/places
ScaledDirectories=16x16@2/actions

[16x16/actions]
Size=16
Context=Actions
Type=Fixed

[16x16@2/actions]
Size=16
Scale=2
Context=Actions
Type=Fixed

[24x24/actions]
Size=24
Context=Actions
Type=Fixed

[scalable/actions]
Size=16
MinSize=8
MaxSize=512
Context=Actions
Type=Scalable

[scalable/status]
Size=16
MinSize=8
MaxSize=512
Context=Status
Type=Scalable

[scalable/places]
Size=64
MinSize=8
MaxSize=512
Context=Places
Type=Scalable
