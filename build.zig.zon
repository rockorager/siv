.{
    .name = .siv,
    .version = "0.1.0",
    .fingerprint = 0xa4af0bfc42868501, // Changing this has security and trust implications.
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        // Shaping (D13, D14). MIT. Lazy: skipped with -fsys=harfbuzz.
        .harfbuzz = .{
            .url = "https://github.com/harfbuzz/harfbuzz/releases/download/14.6.0/harfbuzz-14.6.0.tar.xz",
            .hash = "N-V-__8AALA2MwYsRwu2ztOutL_7hfr730IcTZrfrcDKkS6V",
            .lazy = true,
        },
        // UAX #9 (D13). Apache-2.0. Lazy: skipped with -fsys=sheenbidi.
        .sheenbidi = .{
            .url = "https://github.com/Tehreer/SheenBidi/archive/refs/tags/v3.0.0.tar.gz",
            .hash = "N-V-__8AAIgBOAH6cmnBI9dBvLckCCTjAdqq4CChOBleYvO_",
            .lazy = true,
        },
        // Image decoding (D14 CBDT/sbix glyphs, D19). Apache-2.0 or MIT.
        // The single-file C release; there is no system library to link.
        // Lazy, like the other vendored C code.
        .wuffs = .{
            .url = "https://github.com/google/wuffs-mirror-release-c/archive/refs/tags/v0.4.0-alpha.10.tar.gz",
            .hash = "N-V-__8AAP5JWgDH1rExLB4QCFqm60SkW51_i6qOXTyhjsWv",
            .lazy = true,
        },
        // Unicode properties and grapheme breaking (D13). MIT.
        // Commit 1fb7343 is the head of main (Zig 0.17, Unicode 18.0.0).
        .uucode = .{
            .url = "https://github.com/jacobsandlund/uucode/archive/1fb73433bba5d93366c57f23ff2e9d7939746500.tar.gz",
            .hash = "uucode-0.2.0-ZZjBPm6FVgBcY-79AHV8ckQj86z0JwOyVyj89VeZrEiv",
        },
        // Unicode Character Database 18.0.0, matching uucode. Unicode License
        // v3 (permissive, data files only; uucode ships the same data).
        // Property files for siv's UAX #14 and UAX #29 scanners and the
        // official conformance tests.
        .ucd = .{
            .url = "https://www.unicode.org/Public/18.0.0/ucd/UCD.zip",
            .hash = "N-V-__8AANHxWwIt4EQAd6ed2GJB3LAy6HBNZO-fmag0ZqR4",
        },
        // libwayland-client bindings and protocol scanner (D7). MIT.
        // Fetched from the GitHub mirror of codeberg.org/ifreund/zig-wayland,
        // which is unreachable from some build hosts (Amp orbs); the content
        // and hash are identical.
        .wayland = .{
            .url = "https://github.com/ifreund/zig-wayland/archive/refs/tags/v0.7.0.tar.gz",
            .hash = "wayland-0.7.0-lQa1kuP8AQD5dW7_o-VKLVD_QbqXe7Zob78r2su7Pyex",
        },
        // Protocol XML is pinned rather than taken from the system so that
        // staging protocols (fifo, commit-timing, color-management) exist on
        // every build host. Only the XML is used; libwayland is a system library.
        .wayland_core = .{
            .url = "https://gitlab.freedesktop.org/wayland/wayland/-/releases/1.26.0/downloads/wayland-1.26.0.tar.xz",
            .hash = "N-V-__8AAA46JQABKU7sa-6xGUAN44uFsYSUS_w79UVuu7qo",
        },
        .wayland_protocols = .{
            .url = "https://gitlab.freedesktop.org/wayland/wayland-protocols/-/releases/1.49/downloads/wayland-protocols-1.49.tar.xz",
            .hash = "N-V-__8AAOTNEADZkChhsSciYizE4kIbZsozjDZXVeG5R_uY",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
        "README.md",
    },
}
