.{
    .name = .siv,
    .version = "0.1.0",
    .fingerprint = 0xa4af0bfc42868501, // Changing this has security and trust implications.
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        // Shaping (D13, D14). MIT. Lazy: skipped with -fsys=harfbuzz.
        .harfbuzz = .{
            .url = "https://github.com/harfbuzz/harfbuzz/releases/download/14.6.0/harfbuzz-14.6.0.tar.xz",
            .hash = "N-V-__8AALA2MwYsRwu2ztOutL_7hfr730IcTZrfrcDKkS6V",
            .lazy = true,
        },
        // UAX #9 (D13). Apache-2.0. Lazy: skipped with -fsys=sheenbidi.
        .sheenbidi = .{
            .url = "https://github.com/Tehreer/SheenBidi/archive/refs/tags/v3.0.0.tar.gz",
            .hash = "N-V-__8AAIgBOAH6cmnBI9dBvLckCCTjAdqq4CChOBleYvO_",
            .lazy = true,
        },
        // Image decoding (D14 CBDT/sbix glyphs, D19). Apache-2.0 or MIT.
        // The single-file C release; there is no system library to link.
        // Lazy, like the other vendored C code.
        .wuffs = .{
            .url = "https://github.com/google/wuffs-mirror-release-c/archive/refs/tags/v0.4.0-alpha.10.tar.gz",
            .hash = "N-V-__8AAP5JWgDH1rExLB4QCFqm60SkW51_i6qOXTyhjsWv",
            .lazy = true,
        },
        // Color management for decoded images (D11, D19): ICC profiles to
        // the linear working space. MIT. Lazy: skipped with -fsys=lcms2.
        .lcms2 = .{
            .url = "https://github.com/mm2/Little-CMS/archive/refs/tags/lcms2.17.tar.gz",
            .hash = "N-V-__8AAFoTpADc6ISFB0o4tCLbYUI8NXZdYGCpgqAlQrsQ",
            .lazy = true,
        },
        // WebP decoding (D19). BSD-3-Clause. Lazy: skipped with -fsys=libwebp.
        .libwebp = .{
            .url = "https://github.com/webmproject/libwebp/archive/refs/tags/v1.5.0.tar.gz",
            .hash = "N-V-__8AAOM4egDNF1p7XMh92AC7yc-Da9ArradyeGsfMXkm",
            .lazy = true,
        },
        // AV1 decoding for AVIF (D19). BSD-2-Clause. The GitHub mirror of
        // code.videolan.org/videolan/dav1d. Lazy: skipped with -fsys=dav1d.
        .dav1d = .{
            .url = "https://github.com/videolan/dav1d/archive/refs/tags/1.5.1.tar.gz",
            .hash = "N-V-__8AADyfswC8PUcbSINU_Y8cAc2lKgEqVi6du23wXLMS",
            .lazy = true,
        },
        // NASM, built for the build machine to assemble dav1d's x86-64
        // assembly (D19). BSD-2-Clause. The release tarball, which carries
        // the sources its perl scripts generate. Lazy: fetched only for
        // x86-64 targets without -fsys=dav1d.
        .nasm = .{
            .url = "https://www.nasm.us/pub/nasm/releasebuilds/2.16.03/nasm-2.16.03.tar.gz",
            .hash = "N-V-__8AAOdiwQAcuTPO3dqgQrt8BtvnkUYJ1Z5tP5qQOphI",
            .lazy = true,
        },
        // AVIF decoding (D19). BSD-2-Clause. Lazy: skipped with -fsys=libavif.
        .libavif = .{
            .url = "https://github.com/AOMediaCodec/libavif/archive/refs/tags/v1.3.0.tar.gz",
            .hash = "N-V-__8AALrIMwFY8GwM-oX2rCUYbENqketjUJByUjoHLhZf",
            .lazy = true,
        },
        // JPEG XL decoding (D19). BSD-3-Clause, with Highway (Apache-2.0 or
        // BSD-3-Clause); built without the boxes that need Brotli. Lazy:
        // skipped with -fsys=libjxl.
        .libjxl = .{
            .url = "https://github.com/libjxl/libjxl/archive/refs/tags/v0.11.1.tar.gz",
            .hash = "N-V-__8AAO_HbgBGkewsrsmQxPPUEzKNRtvZGlyafTky-zOf",
            .lazy = true,
        },
        .highway = .{
            .url = "https://github.com/google/highway/archive/refs/tags/1.2.0.tar.gz",
            .hash = "N-V-__8AAODLaQBqNvEIfh_2K_DEv5Ivn1EgOsrbhetLQpvS",
            .lazy = true,
        },
        // Shader compiler for the Vulkan renderer (D10), built for the host
        // and run at build time; nothing of it ships in libsiv. BSD-3-Clause,
        // BSD-2-Clause, MIT, and Apache-2.0, except the generated parser
        // (GPL-3.0 with the Bison exception, which covers its use here).
        // Lazy: skipped with -fsys=glslang.
        .glslang = .{
            .url = "https://github.com/KhronosGroup/glslang/archive/refs/tags/16.6.0.tar.gz",
            .hash = "N-V-__8AAMmpvgL92dJGQdndHv_3KUj32P-C6QWT83-1-lEM",
            .lazy = true,
        },
        // Lua 5.5 for libsiv-lua (D23). MIT. The release tarball from
        // lua.org, whose published SHA-256 is 1c4b4068d67061f2a2231ad2b542
        // 2e77acea1487ea9890f6320af614f4373dce. libsiv-lua compiles its core
        // and an allowlist of standard libraries. Lazy: skipped with
        // -fsys=lua.
        .lua = .{
            .url = "https://www.lua.org/ftp/lua-5.5.1.tar.gz",
            .hash = "N-V-__8AAPqeFQDipy0CdI6MKBmwYYarybBTO3IIJPrSzH_w",
            .lazy = true,
        },
        // Unicode properties and grapheme breaking (D13). MIT.
        // Commit 1fb7343 is the head of main (Zig 0.17, Unicode 18.0.0).
        .uucode = .{
            .url = "https://github.com/jacobsandlund/uucode/archive/1fb73433bba5d93366c57f23ff2e9d7939746500.tar.gz",
            .hash = "uucode-0.2.0-ZZjBPm6FVgBcY-79AHV8ckQj86z0JwOyVyj89VeZrEiv",
        },
        // Unicode Character Database 18.0.0, matching uucode. Unicode License
        // v3 (permissive, data files only; uucode ships the same data).
        // Property files for siv's UAX #14 and UAX #29 scanners and the
        // official conformance tests.
        .ucd = .{
            .url = "https://www.unicode.org/Public/18.0.0/ucd/UCD.zip",
            .hash = "N-V-__8AANHxWwIt4EQAd6ed2GJB3LAy6HBNZO-fmag0ZqR4",
        },
        // libwayland-client bindings and protocol scanner (D7). MIT.
        // Fetched from the GitHub mirror of codeberg.org/ifreund/zig-wayland,
        // which is unreachable from some build hosts (Amp orbs); the content
        // and hash are identical.
        .wayland = .{
            .url = "https://github.com/ifreund/zig-wayland/archive/refs/tags/v0.7.0.tar.gz",
            .hash = "wayland-0.7.0-lQa1kuP8AQD5dW7_o-VKLVD_QbqXe7Zob78r2su7Pyex",
        },
        // Protocol XML is pinned rather than taken from the system so that
        // staging protocols (fifo, commit-timing, color-management) exist on
        // every build host. Only the XML is used; libwayland is a system library.
        .wayland_core = .{
            .url = "https://gitlab.freedesktop.org/wayland/wayland/-/releases/1.26.0/downloads/wayland-1.26.0.tar.xz",
            .hash = "N-V-__8AAA46JQABKU7sa-6xGUAN44uFsYSUS_w79UVuu7qo",
        },
        .wayland_protocols = .{
            .url = "https://gitlab.freedesktop.org/wayland/wayland-protocols/-/releases/1.49/downloads/wayland-protocols-1.49.tar.xz",
            .hash = "N-V-__8AAOTNEADZkChhsSciYizE4kIbZsozjDZXVeG5R_uY",
        },
        // Layer surfaces and foreign toplevel management (D31), which
        // wayland-protocols lacks. No releases; pinned to a commit. Only
        // the XML is used. Each file's notice is HPND (MIT-style).
        // Fetched over git rather than as GitLab's generated archive, which
        // GitLab regenerates with different bytes now and then: the hash
        // covers the commit's tree, which cannot change.
        .wlr_protocols = .{
            .url = "git+https://gitlab.freedesktop.org/wlroots/wlr-protocols.git#bf4fc79abc359eea5a0edec0ac6d4a2b2955f82a",
            .hash = "N-V-__8AAMq4AQASESNUzI38keQUB1Pz9OXa_YoUwXAgWQQl",
        },
        .commonmark_spec = .{
            .url = "https://github.com/commonmark/commonmark-spec/archive/refs/tags/0.31.2.tar.gz",
            .lazy = true,
            .hash = "N-V-__8AAONuBAD-PVybaAwpHC3ymgRfmKlnrH5tdJtUE0Cu",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        // build.zig imports these, so a fetched package needs them.
        "apps/files/build_steps.zig",
        "docs/guide/build_steps.zig",
        "webview",
        "LICENSE",
        "README.md",
    },
}
